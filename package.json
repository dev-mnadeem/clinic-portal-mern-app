{
  "name": "clinic-portal",
  "version": "1.0.0",
  "description": "A clinic portal: patients book appointments, doctors write prescriptions, pharmacies dispense, labs file reports.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "node --test backend/tests/*.test.js",
    "server": "nodemon backend/server.js",
    "client": "npm start --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "start": "node backend/server.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^8.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.1.0",
    "nodemon": "^2.0.22"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.3.1"
  }
}
