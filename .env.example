# Copy to .env and fill in. .env is gitignored; never commit a populated copy.

# Used by `npm start` and the scripts. Docker Compose sets its own MONGO_URI.
# Transactions need a replica set, hence ?replicaSet=rs0.
MONGO_URI=mongodb://localhost:27017/curify?replicaSet=rs0
PORT=5000

# Required everywhere, including Compose. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGIN=http://localhost:3000
