# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# A populated value of this variable was committed to this repository's history
# twice, exposing two MongoDB Atlas cluster passwords. Blanking the file did not
# remove them from history.
MONGO_URI=mongodb://localhost:27017/curify
PORT=5000

# Generate a fresh secret with: openssl rand -hex 32
JWT_SECRET=
CORS_ORIGIN=http://localhost:3000
